# Local development
DATABASE_URL="postgresql://luxeforless:luxeforless@localhost:5433/luxeforless"

# VTO service (local Mac or Kaggle ngrok URL)
VTO_SERVICE_URL="http://localhost:8001"
NEXT_PUBLIC_VTO_SERVICE_URL="http://localhost:8001"

# Optional — only needed for local file uploads outside /public
STORAGE_PATH="../../storage"

# --- Cloud (Option A) ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# NEXT_PUBLIC_VTO_SERVICE_URL="https://YOUR-NGROK-URL.ngrok-free.app"
# VTO_SERVICE_URL="https://YOUR-NGROK-URL.ngrok-free.app"

# VTO backend: auto | local | fashn-max | fashn-v16
# auto = FASHN API if FASHN_API_KEY set, else Kaggle/local GPU
VTO_BACKEND="auto"

# FASHN cloud (Try-On Max / v1.6) — https://app.fashn.ai/api
# FASHN_API_KEY=""
# FASHN_RESOLUTION="1k"
# FASHN_GENERATION_MODE="balanced"
# FASHN_V16_MODE="quality"

# Kaggle GPU ultra mode (set in notebook, not Vercel — no API key needed):
# VTO_ULTRA_MODE=true
# VTO_NUM_TIMESTEPS=32
# VTO_MAX_IMAGE_SIZE=1280
# VTO_UPSCALE_FACTOR=2

# Privacy cron (Vercel Production) — random secret, never commit real value
# CRON_SECRET="generate-a-long-random-string"

# Optional Cloudflare R2 / S3 for garment uploads on Vercel serverless
# S3_BUCKET="luxeforless-assets"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_PUBLIC_BASE_URL="https://pub-xxx.r2.dev"
# S3_REGION="auto"
